{
  "name": "promethee-mcp",
  "version": "0.1.1",
  "description": "GitHub Release+npx Promethee MCP with local browser sign-in and bounded task/project tools.",
  "private": true,
  "type": "module",
  "bin": {
    "promethee-mcp": "dist/product/src/cli.js",
    "prometheemcp": "dist/product/src/cli.js"
  },
  "files": [
    "dist/product/src",
    "web/dist"
  ],
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/mark-cli-executable.mjs",
    "cli": "node --enable-source-maps dist/product/src/cli.js",
    "test:compile": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run test:compile && node --test --enable-source-maps .tmp/test-dist/tests/*.test.js",
    "test:package": "node scripts/smoke-packed-cli.mjs",
    "check": "npm run typecheck && npm test",
    "prepare": "npm run build",
    "start": "node --enable-source-maps dist/product/src/cli.js serve"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "jose": "6.2.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  }
}
