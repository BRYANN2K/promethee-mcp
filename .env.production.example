# Public deployment identity.
MCP_DOMAIN=mcp.example.com
ACME_EMAIL=operator@example.com

# Browser-safe Promethee Supabase publishable key. Never use a service-role key.
PROMETHEE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Caddy Basic Auth protects the browser login and connection routes.
# Escape every `$` in the generated Caddy hash as `$$` for Compose interpolation.
PROMETHEE_MCP_ADMIN_USER=operator
PROMETHEE_MCP_ADMIN_PASSWORD_HASH=replace_with_caddy_hash_password_output

# Generate three different random Base64URL values. Never reuse them.
PROMETHEE_MCP_PERSONAL_ACCESS_TOKEN=replace_with_43_to_128_base64url_characters
PROMETHEE_MCP_EDGE_TOKEN=replace_with_43_to_128_base64url_characters
PROMETHEE_MCP_CURSOR_KEY_BASE64URL=replace_with_exactly_43_base64url_characters
PROMETHEE_MCP_SESSION_KEY_BASE64URL=replace_with_exactly_43_base64url_characters
